<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/_3sdp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_photo"
        android:layout_width="@dimen/_0sdp"
        android:layout_height="@dimen/_0sdp"
        android:background="@color/colorBlack34"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

    <!-- Dimmed only while selected, so the tick reads clearly over any photo. -->
    <View
        android:id="@+id/view_selection_scrim"
        android:layout_width="@dimen/_0sdp"
        android:layout_height="@dimen/_0sdp"
        android:background="@drawable/bg_report_selected"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/image_photo"
        app:layout_constraintEnd_toEndOf="@+id/image_photo"
        app:layout_constraintStart_toStartOf="@+id/image_photo"
        app:layout_constraintTop_toTopOf="@+id/image_photo" />

    <ImageView
        android:id="@+id/image_check"
        android:layout_width="@dimen/_18sdp"
        android:layout_height="@dimen/_18sdp"
        android:layout_margin="@dimen/_6sdp"
        android:background="@drawable/bg_report_check"
        android:contentDescription="@string/action_report"
        android:padding="@dimen/_2sdp"
        android:src="@drawable/ic_report_check"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/image_photo"
        app:layout_constraintTop_toTopOf="@+id/image_photo" />
</androidx.constraintlayout.widget.ConstraintLayout>
