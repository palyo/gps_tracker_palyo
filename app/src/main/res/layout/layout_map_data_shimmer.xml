<?xml version="1.0" encoding="utf-8"?>
<!--
  Loading skeleton for the stamp panel (map thumbnail + location details).
  Overlaid on top of a map-data panel and shown while the map tile and the
  reverse-geocoded location are still being fetched. The activity toggles its
  visibility and drives startShimmer()/stopShimmer().
-->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.85"
    app:shimmer_highlight_alpha="0.5"
    app:shimmer_duration="900">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_8sdp">

        <!-- Map thumbnail placeholder -->
        <View
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            android:background="@drawable/bg_shimmer_placeholder" />

        <!-- Location detail lines placeholder -->
        <LinearLayout
            android:layout_width="@dimen/_0sdp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_10sdp"
                android:background="@drawable/bg_shimmer_placeholder" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/bg_shimmer_placeholder" />

            <View
                android:layout_width="@dimen/_120sdp"
                android:layout_height="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/bg_shimmer_placeholder" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/bg_shimmer_placeholder" />

            <View
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/bg_shimmer_placeholder" />
        </LinearLayout>
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
