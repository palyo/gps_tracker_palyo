<?xml version="1.0" encoding="utf-8"?>
<!-- A single zoom chip. The active ratio gets a filled accent pill, the way
     the stock camera marks the selected lens; the rest stay transparent so
     the row reads as one flat control. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorAccent" />
            <corners android:radius="@dimen/_16sdp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/_16sdp" />
        </shape>
    </item>
</selector>
