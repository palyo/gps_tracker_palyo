<?xml version="1.0" encoding="utf-8"?>
<!-- Pill that holds the 1x / 2x zoom chips. It sits on the black strip under
     the preview, so the fill is lifted off pure black rather than being a
     translucent scrim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1D1D1D" />
    <corners android:radius="@dimen/_20sdp" />
</shape>
